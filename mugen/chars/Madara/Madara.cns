; Susanoo Alante
[Statedef 160]
type    = A
movetype= I
physics = N
juggle  = 1
velset = 0,0
ctrl = 0
anim = 160
sprpriority = 4

[State 0, BindToRoot]
type = BindToRoot
trigger1 = 1
pos = -3*Helper(999999),Fvar(16),0*Helper(999999),Fvar(16)

[State 0, VarAdd]
type = VarAdd
trigger1 = time < 5
v = 1
value = 51

[State 0, Trans]
type = Trans
trigger1 = 1
trans = addalpha
alpha = Var(1),256

[State 0, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = Noshadow

[State 200, End]
type = Changestate
trigger1 = root,stateno != [120,155]
value = 161
