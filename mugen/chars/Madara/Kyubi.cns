;===============================================================================
;----------------------KYUBI----------------------------------------------------
;-------------------------------------------------------------------------------
; Stance
[Statedef 4000]
type    = S
movetype= I
physics = S
juggle  = 1
velset = 0,0
ctrl = 0
anim = 4000
sprpriority = -1

[State 0, NotHitBy]
type = NotHitBy
trigger1 = root,var(4) = 0
value = SCA,NA,SA,HA,NP,SP,HP,NT,ST,HT
time = 1
[State 0, HitOverride]
type = HitOverride
trigger1 = root,var(4) = 1
attr = SCA,NA,SA,HA,NP,SP,HP,NT,ST,HT
stateno = 4150
time = 1

[State 0, SprPriority]
type = SprPriority
trigger1 = root,var(4) = 1
value = 0
[State 0, SprPriority]
type = SprPriority
trigger1 = root,var(4) = 0
value = -1
[State 0, ScreenBound]
type = ScreenBound
trigger1 = root,var(4) = 0
value = 0

[State 0, Tiempo Limite]
type = Helper
trigger1 = prevstateno = 4001 && time = 0
helpertype = normal
name = "Tiempo Limite"
ID = 4030
stateno = 4030
pos = 99999,99999
postype = p1
ownpal = 1

[State 0, Turn]
type = Turn
trigger1 = root,var(4) = 1 && p2bodydist x < -50

[State 0, VarSet]
type = VarSet
trigger1 = time = 0
fv = 5
value = 0

[State 0, VarAdd]
type = VarAdd
trigger1 = animelemtime(1) = [0,30]
fv = 5
value = .0025

[State 0, VarAdd]
type = VarAdd
trigger1 = animelemtime(1) = [31,60]
fv = 5
value = -.0025

[State 0, AngleDraw]
type = AngleDraw
trigger1 = 1
value = 0
scale = 1-(fvar(5)/4),1+(fvar(5)/2)

[State 200, RUN FWD]
type = ChangeState
trigger1 = root,var(4) = 1 && root,ailevel = 0 && (ifelse(facing = root,facing,root,command = "FF",root,command = "BB"))
trigger2 = root,var(4) = 1 && root,ailevel > 0 && random < (ailevel * 100)/8
trigger2 = p2bodydist x > 200
value = 4100

[State 200, HOP BACK]
type = ChangeState
trigger1 = root,var(4) = 1 && root,ailevel = 0 && (ifelse(facing = root,facing,root,command = "BB",root,command = "FF"))
trigger2 = root,var(4) = 1 && root,ailevel > 0 && random < (ailevel * 100)/8
trigger2 = p2bodydist x < 100 && p2movetype = A
value = 4105

[State 200, WALK FWD]
type = ChangeState
trigger1 = root,var(4) = 0 && backedgebodydist < -50
trigger2 = root,var(4) = 1 && root,ailevel = 0 && (ifelse(facing = root,facing,root,command = "holdfwd",root,command = "holdback"))
trigger3 = root,var(4) = 1 && root,ailevel > 0 && random < (root,ailevel * 100)/4
trigger3 = p2bodydist x > 50
value = 4020

[State 200, WALK BACK]
type = ChangeState
trigger1 = root,var(4) = 0 && backedgebodydist > 50
trigger2 = root,var(4) = 1 && root,ailevel = 0 && (ifelse(facing = root,facing,root,command = "holdback",root,command = "holdfwd"))
trigger3 = root,var(4) = 1 && root,ailevel > 0 && random < (root,ailevel * 100)/6
trigger3 = p2bodydist x < 50 && p2movetype = H
value = 4021

[State 200, JUMP]
type = ChangeState
trigger1 = root,var(4) = 1 && root,ailevel = 0 && root,command = "holdup"
trigger2 = root,var(4) = 1 && root,ailevel > 0 && random < (root,ailevel * 100)/4
trigger2 = p2bodydist x < 100 && p2movetype = A
value = 4040

[State 200, Down A]
type = ChangeState
Triggerall = numhelper(4450) = 0
trigger1 = root,var(4) = 0 && (p2bodydist x = [75,150]) && random < 20
trigger2 = root,var(4) = 1 && root,ailevel = 0 && (root,command = "holddown" && root,command = "a")
trigger3 = root,var(4) = 1 && root,ailevel > 0 && random < (root,ailevel * 100)
trigger3 = (p2bodydist x = [75,150])
value = 4400

[State 200, A]
type = ChangeState
trigger1 = root,var(4) = 0 && p2bodydist x < 60 && random < 25
trigger2 = root,var(4) = 1 && root,ailevel = 0 && root,command = "a"
trigger3 = root,var(4) = 1 && root,ailevel > 0 && random < (root,ailevel * 100)
trigger3 = p2bodydist x < 60
value = 4200

[State 200, Down B]
type = ChangeState
trigger1 = root,var(4) = 0 && (p2bodydist x < 80) && random < 20
trigger2 = root,var(4) = 1 && root,ailevel = 0 && (root,command = "holddown" && root,command = "b")
trigger3 = root,var(4) = 1 && root,ailevel > 0 && random < (root,ailevel * 100)
trigger3 = (p2bodydist x < 80)
value = 4500

[State 200, B]
type = ChangeState
trigger1 = root,var(4) = 0 && (p2bodydist x = [50,100]) && random < 25
trigger2 = root,var(4) = 1 && root,ailevel = 0 && root,command = "b"
trigger3 = root,var(4) = 1 && root,ailevel > 0 && random < (root,ailevel * 100)
trigger3 = p2bodydist x = [50,100]
value = 4300

[State 200, End]
type = ChangeState
trigger1 = numhelper(4030) = 0
trigger2 = var(8) >= 380
trigger3 = roundstate != 2
value = 4002

[State 0, KYUBI PARA LA TRANSFORM]
type = Explod
trigger1 = root,stateno = 40001
anim = 4000
ID = 4000
pos = 0,0
postype = p1
removetime = 80
scale = .45*Helper(999999),Fvar(16),.45*Helper(999999),Fvar(16)
sprpriority = -1
ontop = 0
ownpal = 1
Supermovetime = 80

[State 200, End]
type = Destroyself
trigger1 = root,stateno = 40001
