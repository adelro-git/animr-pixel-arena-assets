[Statedef -3]
[State 0, Helper de Conexiones]
type = Helper
Triggerall = numhelper(700) = 0
trigger1 = (stateno = 200||stateno = 300||stateno = 600) && movecontact
trigger2 = stateno = 210 && helper(215),time >= 13 && helper(215),movecontact
trigger3 = stateno = 220 && helper(225),time > 15 && helper(225),movecontact
trigger4 = stateno = 310 && helper(315),time >= 16 && helper(315),movecontact
trigger5 = stateno = 320 && time >= 10 && movecontact
trigger6 = stateno = 330 && helper(335),time >= 6 && helper(335),movecontact
helpertype = normal
name = "Helper de Conexiones"
ID = 700
stateno = 700
pos = 999999,999999
postype = p1

[State 0, HELPER ESCALA]
type = Helper
trigger1 = NUMHELPER(999999) = 0
helpertype = normal
name = "HELPER ESCALA"
ID = 999999
stateno = 999999
pos = 9999,9999
postype = P1
facing = 1
keyctrl = 0
ownpal = 1
supermove = 999999
pausemove = 999999
supermovetime = 999999
pausemovetime = 999999
