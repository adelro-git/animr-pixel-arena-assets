; Control Kyubi:
;-------------------------------------------------------------------------------
[State 0, VarSet] ; CONTROL ON
type = VarSet
trigger1 = !ishelper && stateno = 1580
v = 4
value = 1

[State 0, VarSet] ; CONTROL OFF
type = VarSet
trigger1 = !ishelper && stateno != 1580 && var(4) != 0
v = 4
value = 0
