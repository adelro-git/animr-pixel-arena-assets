[Info]
name 		= "Hidden Entrance"
displayname 	= "%"
mugenversion 	= 1.1
author 		= "AceMillion"
;ReEdit   = "********-----Remake by Daniel's-------******" 

[Camera]
startx = 0
starty = 0
boundleft = -110
boundright = 140
boundhigh = -200
boundlow = 0
tension = 100
zoomin = 1.4
zoomout = .7

[PlayerInfo]
;--- Player 1 ---
 ;Player 1 starting coordinates.
p1startx = -150         ;Starting x coordinates
p1starty = 0            ;Starting y coordinates
p1facing = 1            ;Direction player faces: 1=right, -=left

;--- Player 2 ---
p2startx = 150
p2starty = 0
p2facing = -1

;--- Player 3 ---
p3startx = -220
p3starty = 0
p3facing = 1

;--- Player 4 ---
p4startx = 220
p4starty = 0
p4facing = -1

;--- Common ---
leftbound  = -4000 ;Left bound (x-movement)
rightbound =  4000 ;Right bound

[Bound]
screenleft = 40   ;Dist from left of screen that player can move to
screenright =40  ;Right edge

[StageInfo]
zoffset = 330
autoturn = 1
resetBG = 0
localcoord =  640,360

[Shadow]
color = 256,256,256    
intensity = 150
                 
 

[Music]
bgmusic = sound/Hidden Entrance.mp3
bgmvolume = 255

[BGdef]
spr = Hidden Entrance.sff
debugbg 	= 0

