;HUNTER NIGHT FIELD:
;--------------------------------------------------------
[Info]
name = "Y"
;--------------------------------------------------------
[Camera]
startx = 0
starty = 0
boundleft = -25
boundright = 25
boundhigh = -100
boundlow = 0
tension = 50
zoomin = 1.4
zoomout = .7
;--------------------------------------------------------
[PlayerInfo]
;--- Player 1 ---
p1startx = -70          ;Starting x coordinates
p1starty = 0            ;Starting y coordinates
p1startz = 0            ;Starting z coordinates
p1facing = 1            ;Direction player faces: 1=right, -1=left
;--- Player 2 ---
p2startx = 70
p2starty = 0
p2startz = 0
p2facing = -1
;--- Common ---
;DEJAR ASI
leftbound  = -1000 ;Left bound (x-movement)
rightbound =  1000 ;Right bound
topbound  =  0     ;Top bound (z-movement)
botbound  =  0     ;Bottom bound
;--------------------------------------------------------
[Scaling]
;DEJAR ASI CASI SIEMPRE
topz     = 0       ;Top z-coordinate for scaling
botz     = 50      ;Bottom z-coordinate for scaling
topscale = 1       ;Scale to use at top
botscale = 1.2     ;Scale to use at bottom
;--------------------------------------------------------
[Bound]
;DEJAR ASI
screenleft = 15
screenright = 15
;--------------------------------------------------------
[StageInfo]
;NIVEL DEL SUELO
zoffset = 180
;PARA QUE GIRE SOLO
autoturn = 1
;DEJAR ASI
resetBG = 0
hires = 1
;--------------------------------------------------------
[Shadow]
intensity = 45
color = 0,0,0
yscale = .3
fade.range = 0,0
;--------------------------------------------------------
[Reflection]
;DEL 0 AL 256
intensity = 0
;--------------------------------------------------------
[Music]
bgmusic  =sound/Hunter_Night_Field.mp3
bgvolume = 255
;========================================================
; Main background definition
[BGdef]
 ;Sprites:
spr = Hunter_Night_Field.sff
debugbg = 0
;================================================================================
;              COMPONENTES DEL STAGE:
;================================================================================
[BG CIELO]
type = Normal
spriteno = 1,0
start = 0,50
delta = 0,0
Layerno = 0
mask = 1

[BG SUELO]
type = Parallax
width = 1000,2000
spriteno = 0,1
start = 0,500
delta = 2,2
Layerno = 0
mask = 1

[BG MONTAÑAS]
type = normal
spriteno = 0,2
start = 0,200
delta = 2,2
Layerno = 0
mask = 1

[BG DIRIGIBLE]
type = normal
spriteno = 2,0
start = 500,0
delta = 1,1
Layerno = 0
mask = 1
velocity = -.5
tile = 1,0
tilespacing = 750
sin.y = -10,100
