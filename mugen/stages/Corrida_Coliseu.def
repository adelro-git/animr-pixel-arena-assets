[Info]
Name = "Coliseo_Corrida"
displayname="["
author="Daniel's" 
mugenversion=1.1

;--------------------------------------------------------
[camera]
startx = 0
starty = 0
boundleft =-380
boundright = 380
boundhigh=-380 
boundlow =0
tension = 50
zoomout = .7
zoomin = 1.4

;--------------------------------------------------------
[PlayerInfo]
;--- Player 1 ---
p1startx = -90          ;Starting x coordinates
p1starty = 0            ;Starting y coordinates
p1startz = 0            ;Starting z coordinates
p1facing = 1            ;Direction player faces: 1=right, -1=left

;--- Player 2 ---
p2startx = 90
p2starty = 0
p2startz = 0
p2facing = -1

;--- Player 3 ---
p3startx = -120
p3starty = 0
p3facing = 1

;--- Player 4 ---
p4startx =120
p4starty = 0
p4facing = -1

;--- Common ---
 ;Don't change these values.
leftbound = -4000
rightbound = 4000
topbound = 0
botbound = 0

;--------------------------------------------------------
[Bound]
screenleft = 25
screenright = 25

;--------------------------------------------------------
[StageInfo]
zoffset = 199
autoturn = 1
resetBG = 0;1
localcoord=384,216
hires = 1

;--------------------------------------------------------
[Shadow]
color = 26,26,26
yscale = .20

;--------------------------------------------------------
[Music]
bgmusic = sound/Corrida_Coliseu.mp3
bgmvolume = 255



