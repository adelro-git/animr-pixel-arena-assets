[Info]
name = "Epic-world"
displayname = "*"
mugenversion = 1.1          
author = "Soknasful"    
;ReEdit   = "********-----Remake by Daniel's-------******" 
;--------------------------------------------------------

[Camera]
startx = 0						
starty = 0
boundleft =-295
boundright =295
boundhigh = -245
boundlow = 0
tension = 100
zoomin = 1.4
zoomout = .7


[PlayerInfo]
p1startx 	= -300        
p1starty 	= 0            
p1facing 	= 1            
p2startx 	= 300
p2starty 	= 0
p2facing 	= -1
p3startx 	= -420
p3starty 	= 0
p3facing 	= 1
p4startx 	= 420
p4starty 	= 0
p4facing 	= -1
leftbound = -4000 
rightbound =  4000

[Bound]
screenleft = 60  
screenright = 60 

[StageInfo]
zoffset = 530
autoturn 	= 1
resetBG 	= 0
localcoord = 1024,576

[Shadow]
intensity = 130
color = 0,0,0
yscale = .3
fade.range = 0,0

[Reflection]
intensity = 0



[Music]
bgmusic = sound/Epic-world.mp3
bgmvolume = 255 

[BGdef]
spr = Epic-world.sff
debugbg = 1


[BG Sky-]
type = normal
spriteno	= 0,0
layerno = 0
start = 0,165
delta = .6,.8
mask = 0
scalestart=1.1,1.1


[BG GROUND LIGHTNING FX]
type  = anim
actionno = 82
start = 0,165
delta = .6,.8



			
