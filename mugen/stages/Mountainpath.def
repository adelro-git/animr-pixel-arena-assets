[Info]
Name = "P"
Author = "suigin"
mugenversion = 1.1

[Camera]
startx         = 0
starty         = 0
boundleft      = -570
boundright     = 570
boundhigh      = -9000
boundlow       = 0
verticalfollow = 0.2
overdrawhigh   = 1000
overdrawlow    = 0
tension        = 100
zoomout        = 0.75
zoomin         = 1.16

[PlayerInfo]
;--- Player 1 ---
p1startx   = -340;1Pの最初の立ち位置X軸
p1starty   = 0;1Pの最初の立ち位置Y軸
p1facing   = 1;1Pの最初の向き。1で右向き 
;--- Player 2 ---
p2startx   = 340
p2starty   = 0
p2facing   = -1
;--- Player 3 ---
p3startx = -480
p3starty = 0
p3facing = 1
;--- Player 4 ---
p4startx = 480
p4starty = 0
p4facing = -1
;--- Common ---
leftbound  = -4000
rightbound = 4000
topbound   = 0
botbound   = 0

[Bound]
screenleft  = 60;左画面端の壁の存在距離
screenright = 60;右画面端の壁の存在距離

[StageInfo]
zoffset  = 670
autoturn = 1
resetBG  = 0
localcoord = 1280,720

[Shadow]
color   = 0,0,0;影のｶﾗｰ(BGR値)
yscale  = .17;影のｻｲｽﾞ
xshear  = 0;影の角度
intensity  = 128;影の濃さ（0薄い、256濃い）
fade.range = -400,-200;影のフェードアウト設定）※初めの値は影が完全に消える高さ、後ろの値は影が消え始める高さ

[BGdef]
spr     = Mountainpath.sff
debugbg = 0;1にすると、画像が無い部分に、残像がつかない。

[Music]
bgmusic      = sound/Mountainpath.mp3
bgmvolume    = 255

[BG Sky2]
type     = normal
spriteno = 0,1
mask     = 1
layerno  = 0
start    = 0,-770
delta    = 0.4,0.2;キャラが動いた時(カメラの移動）のスクロールスピード。奥のレイヤーほど遅れて見えるのでそれより小さい値になる。
velocity = 0.2,0
tile     = 1,0
tilespacing = 0,0

