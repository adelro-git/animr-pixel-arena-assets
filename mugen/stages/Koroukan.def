[Info]
Name = "#"
Author = "Alice"
mugenversion=1.1

[Camera]
boundleft = -300;-250
boundright =300; 250
boundhigh = -700
boundlow = 0
tension = 100
zoomin = 1.4
zoomout = .7


[PlayerInfo]
;--- Player 1 ---
 ;Player 1 starting coordinates.
p1startx = -280         ;Starting x coordinates
p1starty = 0            ;Starting y coordinates
p1facing = 1            ;Direction player faces: 1=right, -1=left

;--- Player 2 ---
p2startx = 280
p2starty = 0
p2facing = -1

;--- Player 3 ---
p3startx = -400
p3starty = 0
p3facing = 1

;--- Player 4 ---
p4startx = 400
p4starty = 0
p4facing = -1

;--- Common ---
leftbound  = -4000 ;Left bound (x-movement)
rightbound =  4000 ;Right bound

[Bound]
screenleft = 80   ;Dist from left of screen that player can move to
screenright = 80   ;Right edge

[StageInfo]
zoffset = 665
autoturn = 1
resetBG = 1
localcoord = 1280,720
xscale = 1
yscale = 1

[Shadow]
intensity = 96
color = 0,0,0
yscale = .3
fade.range = 0,0

[Reflection]
intensity = 0

[Music]
bgmusic =sound/Koroukan.mp3
bgmvolume = 255

[BGdef]
spr = Koroukan.sff
debugbg = 0

;-------------------------start
;--------------------------black
[BG 1]
type  = normal
spriteno = 20, 0
start = 0, -50
delta = 0, 0
mask = 0
tile = 1,1
tilespacing = 0,0
trans = none


[BG sky2]
type  = normal
spriteno = 1, 3
start = 0,-770
delta = .4, .4
mask = 0
trans = none
