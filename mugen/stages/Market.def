[Info]
Name = "!"
Author = "Alice"
mugenversion=1.1

[Camera]
boundleft = -230
boundright = 230
boundhigh =-700
boundlow = 0
tension = 100
zoomin = 1.4
zoomout = .7

[PlayerInfo]
;--- Player 1 ---
 ;Player 1 starting coordinates.
p1startx = -280         ;Starting x coordinates
p1starty = 0            ;Starting y coordinates
p1facing = 1            ;Direction player faces: 1=right, -1=left

;--- Player 2 ---
p2startx = 280
p2starty = 0
p2facing = -1

;--- Player 3 ---
p3startx = -400
p3starty = 0
p3facing = 1

;--- Player 4 ---
p4startx = 400
p4starty = 0
p4facing = -1

;--- Common ---
leftbound  = -4000 ;Left bound (x-movement)
rightbound =  4000 ;Right bound

[Bound]
screenleft = 80   ;Dist from left of screen that player can move to
screenright = 80   ;Right edge

[StageInfo]
zoffset = 685
autoturn = 1
resetBG = 0
localcoord = 1280,720
xscale = 1
yscale = 1

[Shadow]
intensity = 96
color = 0,0,0
yscale = .3
fade.range = 0,0

[Reflection]
intensity = 0

[Music]
bgmusic =sound/Market.MP3
bgmvolume = 255

[BGdef]
spr = Market.sff
debugbg = 0

