;_________________________________________________________
;PARAMETRY
;_________________________________________________________
[Camera]
startx 		= 0
starty 		= 0
boundleft 	= -150
boundright 	= 150
boundhigh 	= -1000
boundlow 	= 0
tension 	= 150
verticalfollow 	= .2
floortension 	= 0
zoomin 		= 1.15
zoomout		= 0.34

[PlayerInfo]
p1startx 	= -900
p1starty 	= 0
p1facing 	= 1
p2startx 	= 900
p2starty 	= 0
p2facing 	= -1
p3startx 	= -400
p3starty 	= 0
p3facing 	= 1
p4startx 	= 400
p4starty 	= 0
p4facing 	= -1
leftbound 	= -4000
rightbound 	= 4000

[Bound]
screenleft 	= 60
screenright 	= 60

[StageInfo]
zoffset 	= 660;615.0
autoturn 	= 1
resetBG 	= 0
localcoord 	= 1280, 720
xscale 		= 1.2
yscale 		= 1.1

[Scaling]
topz     	= 0
botz     	= 50
topscale 	= 1
botscale 	= 1.2

[Shadow]
intensity = 200
color = 0,0,0
yscale = 0.5
fade.range = -600,-300
xshear = 0.4

[Music]
bgmusic 		= sound/Obito's_Dimension_Kamui.mp3
bgmvolume 		= 255

[BGdef]
spr = Obito's_Dimension_Kamui.sff
debugbg = 0

